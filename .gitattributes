# Git LFS tracking for large files
*.pth filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.osm.pbf filter=lfs diff=lfs merge=lfs -text
*.geotiff filter=lfs diff=lfs merge=lfs -text

# Text files
*.md text
*.txt text
*.py text
*.yaml text
*.yml text
*.json text

# Line endings
* text=auto
*.py text eol=lf
*.sh text eol=lf
